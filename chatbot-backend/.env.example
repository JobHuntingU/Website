# Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-flash-lite-latest
CHROMA_DB_PATH=./jhu_vectordb
CHROMA_COLLECTION_NAME=jhu_knowledge
KNOWLEDGE_BASE_DIR=../../knowledge_base_jhu

# Airtable — lead capture storage (get a token at airtable.com/create/tokens)
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=Leads
