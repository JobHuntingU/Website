# --- SERVER CONFIGURATION ---
PORT=3001
JWT_SECRET=your_jwt_secret_key

# --- FRONTEND CONFIGURATION ---
VITE_API_BASE_URL=http://localhost:3001

# --- THIRD-PARTY INTEGRATIONS ---
