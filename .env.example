# --- CHATBOT (chatbot-backend) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
CHROMA_DB_PATH=./jhu_vectordb
CHROMA_COLLECTION_NAME=jhu_knowledge
